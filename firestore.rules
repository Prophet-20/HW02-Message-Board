rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function own(uid) { return signed() && request.auth.uid == uid; }
    function label(s, max) { return s is string && s.size() > 0 && s.size() <= max; }
    match /users/{uid} {
      allow get: if own(uid);
      allow create: if own(uid) && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid','firstName','lastName','role','registrationDateTime'])
        && label(request.resource.data.firstName,60) && label(request.resource.data.lastName,60)
        && request.resource.data.role == 'student' && request.resource.data.registrationDateTime == request.time;
    }
    match /messages/{id} {
      allow read: if signed();
      allow create: if own(request.resource.data.authorUid)
        && request.resource.data.keys().hasOnly(['authorUid','authorName','text','createdAt','editedAt','schemaVersion'])
        && request.resource.data.authorName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.firstName
        && label(request.resource.data.text,1000) && request.resource.data.createdAt == request.time
        && request.resource.data.editedAt == null && request.resource.data.schemaVersion == 2;
      allow update: if own(resource.data.authorUid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt'])
        && label(request.resource.data.text,1000) && request.resource.data.editedAt == request.time;
      allow delete: if own(resource.data.authorUid);
    }
  }
}
